<?xml version="1.0" encoding="utf-8"?>
<!-- Day count and the breathing pause, at a glance on the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/today_day_label"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_day"
        style="@style/WidgetDay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/widget_feeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_breathe"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_button"
        android:drawableStart="@drawable/ic_breath"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/today_tool_breathe"
        android:textColor="#1F2A23"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
