<?xml version="1.0" encoding="utf-8"?>
<!-- The hero follows its verdict: the same card in the warning tint when something needs review. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/warning_soft"
        android:endColor="@color/hero_end" />
    <corners android:radius="@dimen/radius_card" />
    <stroke android:width="1dp" android:color="@color/warning_border" />
</shape>
