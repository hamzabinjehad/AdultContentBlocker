<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_accent">
    <item>
        <selector>
            <item android:state_focused="true" android:state_enabled="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="@dimen/radius_pill" />
                    <stroke android:width="2dp" android:color="@color/on_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent" />
                    <corners android:radius="@dimen/radius_pill" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
