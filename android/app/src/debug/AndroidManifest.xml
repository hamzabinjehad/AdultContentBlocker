<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="app.hisn.android.VisualBenchmarkActivity"
            android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="app.hisn.android.VisualCaptureTestActivity"
            android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name="app.hisn.android.VisualModelCheckActivity"
            android:exported="true" android:permission="android.permission.DUMP" />
        <!-- Shell-only diagnostic entry point. Absent from release APKs. -->
        <activity android:name="app.hisn.android.GuardTestSetupActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- Read-only managed-uninstall status exporter for the shell test. -->
        <activity android:name="app.hisn.android.ManagedStatusActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Tighten-only managed-mode fixture setup for the acceptance run. -->
        <activity android:name="app.hisn.android.ManagedTestSetupActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- One-shot pairing/policy runtime check; software key in private prefs. -->
        <activity android:name="app.hisn.android.GuardianPairDebugActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Shell-only trampoline for the non-exported product pairing screen. -->
        <activity android:name="app.hisn.android.GuardianPairTestActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Shell-only App-info launcher for the physical guard test. -->
        <activity android:name="app.hisn.android.OpenAppInfoTestActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Shell-only clipboard reader for the pairing-screen test. -->
        <activity android:name="app.hisn.android.ClipboardDumpActivity"
            android:exported="true" android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
