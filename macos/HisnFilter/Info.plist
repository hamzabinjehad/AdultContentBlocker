<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- This dictionary is what makes the bundle a content filter rather than
	     some other kind of system extension. The provider class name must be
	     module-qualified: with a bare "FilterDataProvider" the extension loads
	     and then fails to instantiate anything, which presents as a filter that
	     starts and blocks nothing. -->
	<key>NetworkExtension</key>
	<dict>
		<!-- The Mach service the app and the bridge reach PolicyService on
		     (FilterXPC.swift). It must be prefixed with one of this
		     extension's app groups, hence the team-prefixed group in
		     HisnFilter.entitlements; the app reads the expanded name back out
		     of this file rather than hard-coding the team. -->
		<key>NEMachServiceName</key>
		<string>$(TeamIdentifierPrefix)app.hisn.filter</string>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.filter-data</key>
			<string>$(PRODUCT_MODULE_NAME).FilterDataProvider</string>
		</dict>
	</dict>
</dict>
</plist>
