      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احجب"
          }
        }
      }
    },
    "Block list version" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصدار قائمة الحجب"
          }
        }
      }
    },
    "Blocked on top of the built-in lists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحجب إضافةً إلى القوائم المدمجة."
          }
        }
      }
    },
    "Blocking Rules" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قواعد الحجب"
          }
        }
      }
    },
    "Blocking still runs; a lock makes it unremovable for a set time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحجب يعمل؛ والقفل يجعله غير قابل للإزالة لمدة محددة."
          }
        }
      }
    },
    "Blocks everything except sites you allow. A block list can never cover every site; this can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحجب كل شيء عدا المواقع التي تسمح بها. لا يمكن لقائمة حجب أن تغطي كل المواقع؛ وهذا يستطيع."
          }
        }
      }
    },
    "Blocks the app's internet access. It still opens, and still works offline — stopping a launch needs Screen Time, which no app can do for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقطع وصول التطبيق إلى الإنترنت. سيبقى يفتح ويعمل دون اتصال — منع تشغيله يحتاج «مدة استخدام الجهاز»، ولا يستطيع أي تطبيق فعل ذلك عنك."
          }
        }
      }
    },
    "Browser extension" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة المتصفح"
          }
        }
      }
    },
    "Browser last connected" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر اتصال للمتصفح"
          }
        }
      }
    },
    "Browsers during a lock" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتصفحات أثناء القفل"
          }
        }
      }
    },
    "Cancel the request" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ الطلب"
          }
        }
      }
    },
    "Cannot remove while a lock is running" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الإزالة أثناء القفل"
          }
        }
      }
    },
    "Catches a site registered today, before any list has it. Works in every app on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلتقط موقعًا سُجّل اليوم قبل أن تضمّه أي قائمة. يعمل في كل التطبيقات على هذا الماك."
          }
        }
      }
    },
    "Check again" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق مجددًا"
          }
        }
      }
    },
    "Check the words on a page" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افحص كلمات الصفحة"
          }
        }
      }
    },
    "Check with your partner that their page shows the same fingerprint." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد مع شريكك أن صفحته تعرض البصمة نفسها."
          }
        }
      }
    },
    "Checking status" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التحقق من الحالة"
          }
        }
      }
    },
    "Checking…" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التحقق…"
          }
        }
      }
    },
    "Come back here — the Browser extension row reads Connected once it has." : {
