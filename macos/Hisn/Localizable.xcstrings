{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” is too short to block safely. Words need at least %lld letters — shorter ones match parts of ordinary words and block pages you need." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» أقصر من أن تُحجب بأمان. يجب ألا تقل الكلمة عن %2$lld أحرف — فالأقصر منها تطابق أجزاءً من كلمات عادية وتحجب صفحات تحتاجها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is too short to block safely. Words need at least %2$lld letters — shorter ones match parts of ordinary words and block pages you need."
          }
        }
      }
    },
    "%@ · until %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · حتى %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · until %2$@"
          }
        }
      }
    },
    "%@ (%@)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ و%2$lld غيرها"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ and %2$lld more"
          }
        }
      }
    },
    "%@ closes in %lld s" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُغلَق %1$@ خلال %2$lld ث"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ closes in %2$lld s"
          }
        }
      }
    },
    "%@ domains blocked for every app" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نطاق محجوب لكل التطبيقات"
          }
        }
      }
    },
    "%@ domains in the hosts file." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نطاق في ملف hosts."
          }
        }
      }
    },
    "%@ has a standard browser profile with Hisn removed or disabled. Restore the extension in every listed profile or %@ will close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد في %1$@ ملف متصفح قياسي حُذفت أو عُطّلت فيه إضافة حصن. أعد الإضافة في كل ملف مُدرج وإلا سيُغلق %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ has a standard browser profile with Hisn removed or disabled. Restore the extension in every listed profile or %2$@ will close."
          }
        }
      }
    },
    "%@ has no Hisn protection inside it, so it cannot stay open while browser guarding is active. Reconnect a supported browser or review your protection settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد حماية حصن داخل %@، لذلك لا يمكن أن يبقى مفتوحًا أثناء تفعيل رقابة المتصفحات. أعد توصيل متصفح مدعوم أو راجع إعدادات الحماية."
          }
        }
      }
    },
    "%@ is about to close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُغلَق %@ بعد قليل."
          }
        }
      }
    },
