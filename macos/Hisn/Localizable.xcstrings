          }
        }
      }
    },
    "Before changing anything, save the current router settings. In its page, look for Internet or DNS. If those settings are unavailable, continue with device protection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل تغيير أي شيء، احفظ إعدادات الراوتر الحالية. ابحث في صفحته عن الإنترنت أو DNS. إذا لم تجد هذه الإعدادات، تابع حماية الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before changing anything, save the current router settings. In its page, look for Internet or DNS. If those settings are unavailable, continue with device protection."
          }
        }
      }
    },
    "Between %@ and %@." : {
