<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Unsandboxed like the app, and for the same reason the bridge was once
	  sandboxed: the two must resolve the app group the same way, so they
	  must be configured the same way. It reads the lock state and asks the
	  filter's PolicyService over XPC; it writes only its check-in stamps.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)app.hisn</string>
		<string>group.app.hisn</string>
	</array>
</dict>
</plist>
