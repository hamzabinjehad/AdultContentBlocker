{
  "manifest_version": 3,
  "name": "Hisn Protection",
  "version": "1.0.0",

  "key": "",

  "description": "Blocks adult content. Once a lock period starts it cannot be turned off until the timer expires.",
  "minimum_chrome_version": "137",

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocklist",
        "enabled": true,
        "path": "rules/dnr_block_rules.json"
      },
      {
        "id": "keywords",
        "enabled": true,
        "path": "rules/dnr_keyword_rules.json"
      },
      {
        "id": "safesearch",
        "enabled": true,
        "path": "rules/safesearch.json"
      },
      {
        "id": "lockdown",
        "enabled": false,
        "path": "rules/lockdown.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "action": {
    "default_title": "Hisn Protection",
    "default_popup": "popup.html"
  },

  "options_page": "options.html",

  "incognito": "spanning",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
