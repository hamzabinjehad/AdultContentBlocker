    "condition": {
      "regexFilter": "^https?://(www\\.|cn\\.)?bing\\.com\\.?(:[0-9]+)?/(search|images/search|videos/search)([?#/]|$)",
      "resourceTypes": ["main_frame", "sub_frame", "xmlhttprequest"]
