<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gray screen writes Android's own grayscale filter. A computer grants this once with
         `adb shell pm grant <package> android.permission.WRITE_SECURE_SETTINGS`; declaring it here is
         what lets that grant apply (it is never granted by an install alone). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Apps to block lists the apps this phone can launch, so Android 11+ needs visibility for
         exactly that intent. No QUERY_ALL_PACKAGES: the picker only ever shows launchable apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Hisn Native"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HisnPrototype">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
