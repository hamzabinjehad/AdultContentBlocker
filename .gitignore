# Signing keys. NEVER commit these — the private key is the root of trust for
# every client that verifies a blocklist.
#
# Rooted with a leading slash on purpose: an unanchored `keys/` matches at any
# depth, which silently swallowed extension/keys/README.md too — that folder
# holds real documentation alongside its own gitignored key, and losing a
# README to a pattern meant for the blocklist signing key is exactly the kind
# of silent hole this project's own threat model warns about elsewhere.
/keys/
*.pem

# Build output. Regenerated by blocklist/build.py and published to the `lists`
# branch by CI; ~19MB changing daily would wreck the history.
dist/

# The seeded starter list is committed (see seed/), the full one is not.
**/domains.packed

__pycache__/
*.pyc
.DS_Store

# Xcode. Hisn.xcodeproj IS committed — it is generated by
# macos/generate_xcodeproj.py, but a clone should build without running it.
xcuserdata/
*.xcuserstate
DerivedData/
macos/build/

# Packed browser-extension artifacts (built from extension/, not source).
*.crx

# Chrome writes its indexed-ruleset cache into the extension directory when it
# is loaded unpacked. Not source, not shippable — `_`-prefixed names are
# reserved and the Web Store rejects a package carrying one.
extension/_metadata/
